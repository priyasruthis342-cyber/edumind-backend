# ─────────────────────────────────────────────────────────────
# EduMind AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────

# Server Port (Auto-assigned by cloud hosts such as Render/Railway, defaults to 5050)
PORT=5050
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas Cloud)
# TIP: In MongoDB Atlas Network Access, ensure 0.0.0.0/0 is added so cloud containers can connect.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/edumaind?retryWrites=true&w=majority

# Google Gemini API Key (Required for Exam Q&A, Chat Box & Audio Story Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (High-speed model: openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_TwxrpdkuvcZNdH
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# CORS: Allowed origins for API requests (comma-separated or * for all)
CORS_ORIGIN=*
