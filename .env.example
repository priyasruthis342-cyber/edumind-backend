# ─────────────────────────────────────────────────────────────
# EduMind AI — Production & Deployment Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite) Environment Variables ──
# (Prefix with VITE_ for Vite bundling)

# Cloud URL of your deployed EduMind backend (e.g. on Render or Railway).
# If deploying frontend and backend together as a single fullstack service, you can omit or leave empty.
VITE_API_URL=https://your-edumind-backend.onrender.com

# Supabase Auth & Cloud Database
VITE_SUPABASE_URL=https://yspneuzrsraonftghccm.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Razorpay Client Public Key
VITE_RAZORPAY_KEY_ID=rzp_test_TwxrpdkuvcZNdH


# ── Backend (Node.js / Express) Environment Variables ──

# Server Port (Auto-assigned by Render, Railway, or Heroku, defaults to 5050)
PORT=5050
NODE_ENV=production

# MongoDB Connection String (e.g., MongoDB Atlas Cloud)
# TIP: In MongoDB Atlas Network Access, ensure 0.0.0.0/0 is whitelisted for cloud containers.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pq73zxs.mongodb.net/edumaind?retryWrites=true&w=majority

# Google Gemini API Key (Exclusive AI for 7-Part Exam Q&A, Chat Box, Quizzes & Audio Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Server Credentials
RAZORPAY_KEY_ID=rzp_test_TwxrpdkuvcZNdH
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# CORS: Allowed origins for API requests (comma-separated for multiple, or * for all)
# Example: https://edumind.vercel.app,https://your-domain.com
CORS_ORIGIN=*

